# Local console. Copy to .env if you want to override defaults.
# There is no messenger token, owner id, or broadcast channel.

MUTINY_BIND_HOST=127.0.0.1
MUTINY_PORT=8765
MUTINY_DB_PATH=mutiny.db
SCHEDULER_DB_PATH=mutiny_console_scheduler.db
LEGACY_SCHEDULER_DB_PATH=mutiny_scheduler.db
MUTINY_PALACE_PATH=~/.mutiny/palace
MUTINY_DOCS_PATH=./research_docs
OLLAMA_API_BASE=http://127.0.0.1:11434
AUTOMATION_TIMEZONE=America/Chicago

# News and any other outbound fetch stay off.
MUTINY_OUTBOUND_ENABLED=0

# Set OLLAMA_NO_CLOUD=1 in the Ollama daemon's own environment before you
# start the daemon. Putting it only in this file does not change a daemon
# that is already running, and it does not make a cloud model local.
